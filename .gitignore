# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# NOTE: lib/config.ts used to live here. It is now committed and secret-free —
# it reads everything from the environment, so GitHub-triggered builds can
# resolve it. Secrets go in .env.local (above) or Vercel env vars.

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.playwright-mcp/
