# Upload filter for `vercel deploy`. NOTE: this REPLACES .gitignore for
# uploads, so anything secret must be listed here explicitly — being in
# .gitignore is not enough to keep it out of a CLI deployment.
node_modules
.next
.git
.claude
scripts
*.tsbuildinfo
next-env.d.ts

# Local secrets. Deployments read these from Vercel env vars; uploading the
# file would both ship secrets in the bundle and shadow the project settings.
.env*
